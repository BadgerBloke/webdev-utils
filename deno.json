{
    "name": "@mksingh/utils",
    "version": "0.1.4",
    "description": "A collection of TypeScript utilities for Deno including route factory with navigation support",
    "author": {
        "name": "MK Singh",
        "email": "your-email@example.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/BadgerBloke/webdev-utils"
    },
    "homepage": "https://github.com/BadgerBloke/webdev-utils",
    "bugs": {
        "url": "https://github.com/BadgerBloke/webdev-utils/issues"
    },
    "keywords": [
        "typescript",
        "deno",
        "utilities",
        "route-factory",
        "navigation",
        "routing",
        "path-resolution"
    ],
    "exports": {
        ".": "./mod.ts",
        "./factories/route-factory": "./factories/route-factory.ts",
        "./zod/get-defaults": "./zod/get-defaults.ts"
    },
    "tasks": {
        "dev": "deno test --watch",
        "test": "deno test",
        "fmt": "deno fmt",
        "lint": "deno lint",
        "check": "deno check mod.ts"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1"
    },
    "fmt": {
        "options": {
            "indentWidth": 4
        }
    },
    "lint": {
        "rules": {
            "tags": [
                "recommended"
            ]
        }
    },
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    }
}
